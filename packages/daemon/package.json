{
  "name": "@agentfloor/daemon",
  "version": "0.1.0",
  "description": "The office daemon: protocol, agent runtimes, model gateway. Runs inside each office VM.",
  "scripts": {
    "daemon": "node --disable-warning=ExperimentalWarning src/daemon/main.ts",
    "office": "node --disable-warning=ExperimentalWarning src/cli/office.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sandbox": "node --disable-warning=ExperimentalWarning scripts/sandbox.ts"
  },
  "type": "module",
  "dependencies": {
    "@agentfloor/shared": "*",
    "@daytona/sdk": "^0.224.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "bin": {
    "office": "bin/office"
  },
  "exports": {
    "./daemon": "./src/daemon/daemon.ts",
    "./config": "./src/core/config.ts",
    "./link": "./src/daemon/link.ts"
  }
}
