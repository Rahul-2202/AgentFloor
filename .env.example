# Copy to .env and fill in. .env is git-ignored. Never commit keys.

# Claude Code agents use your Claude login (run `claude auth login` once).
# Optional: set an Anthropic API key instead of the login.
ANTHROPIC_API_KEY=

# Junie agents (Gemini via your own key; no JetBrains login needed)
GEMINI_API_KEY=

# Antigravity agents use your Google sign-in (run `agy` once).

# Phase 6: Daytona cloud sandbox (app.daytona.io → Keys)
DAYTONA_API_KEY=
# Claude login for agents in the sandbox: run `claude setup-token` and paste it here
AGENTFLOOR_CLAUDE_TOKEN=

# Daemon
AGENTFLOOR_PORT=4300
