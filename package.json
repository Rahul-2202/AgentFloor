{
  "name": "agentfloor",
  "version": "0.1.0",
  "description": "AgentFloor prototype: office daemon and agent-to-agent protocol",
  "scripts": {
    "daemon": "node --disable-warning=ExperimentalWarning src/daemon/main.ts",
    "office": "node --disable-warning=ExperimentalWarning src/cli/office.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sandbox": "node --disable-warning=ExperimentalWarning scripts/sandbox.ts"
  },
  "type": "module",
  "dependencies": {
    "@daytona/sdk": "^0.224.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "private": true,
  "bin": {
    "office": "bin/office"
  }
}
