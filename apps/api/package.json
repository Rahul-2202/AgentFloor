    "@fastify/websocket": "^11.3.4",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agentfloor/daemon": "*",
    "@types/ws": "^8.18.1"
  }
}
