{
  "name": "@agentfloor/api",
  "version": "0.1.0",
  "private": true,
  "description": "The Control API: auth, offices, the policy engine, Ada, and the link to each office daemon",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
