    "check:supabase": "node scripts/check-supabase.ts",
    "check:ada": "node scripts/check-ada.ts"
  },
  "dependencies": {
    "@agentfloor/shared": "*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
